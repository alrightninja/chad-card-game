PORT=4000
MONGO_URI=mongodb+srv://USER:PASSWORD@YOUR_CLUSTER.mongodb.net/gigachad
JWT_SECRET=change-me-to-a-long-random-string
FRONTEND_URL=http://localhost:3000
DEV_TOOLS=true
# Password reset email. Use Resend or SMTP. With DEV_TOOLS=true, the API also returns resetUrl.
# RESEND_API_KEY=
# MAIL_FROM=Gigachad TCG <noreply@yourdomain.com>
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
ADMIN_SECRET=change-me-admin-secret
# ISO-8601 UTC. Packs appear in the shop at these instants.
# ULTRA_NIGHTMARE_RELEASE_AT=2026-11-16T05:00:00.000Z
# TO_THE_HILT_RELEASE_AT=2026-12-01T05:00:00.000Z
# CHAOS_RELEASE_AT=2027-02-01T05:00:00.000Z
